rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Sicherheitsregeln der Firestore-Datenbank von luciajason.de
//
//  Einfügen: Firebase-Konsole → Firestore Database → Regeln →
//  kompletten Inhalt dieser Datei ersetzen → „Veröffentlichen".
//
//  Sammlungen:
//    users/{uid}          Profil — nur die Person selbst liest und schreibt
//    users/{uid}/bilder/titel      { teile, typ }
//    users/{uid}/bilder/titel-0…7  { daten }
//                         eigenes Titelbild in voller Auflösung (bis 4K) —
//                         zu groß für ein Dokument (1 MB), deshalb in Teilen
//    usernames/{name}     { uid } — sorgt dafür, dass jeder Name nur
//                         einmal existiert; lesbar für alle, damit sich
//                         „Name schon vergeben" vor dem Registrieren prüfen lässt
//    newsletter/{uid}     { email, lang, consentAt } — nur mit bestätigter
//                         E-Mail-Adresse, nur die eigene Adresse
//    bestenliste/{uid}    { name, punkte, updatedAt } — Bestwert im
//                         Browser-Spiel; für alle lesbar, schreiben nur
//                         den eigenen Eintrag
//
//  Alles andere ist gesperrt. Auslesen der Newsletter-Liste geht nur
//  über die Firebase-Konsole (Projektinhaber).
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function angemeldet() {
      return request.auth != null;
    }

    function istSelbst(uid) {
      return angemeldet() && request.auth.uid == uid;
    }

    function profilFelder() {
      return ['username', 'usernameLower', 'bio', 'avatar', 'avatarEigen', 'cover',
              'favChar', 'plattform', 'edition', 'lieblingsort', 'vorfreude', 'gamertag',
              'lang', 'createdAt', 'updatedAt'];
    }

    // Eigenes Bild als data:-URL (JPEG/WebP), im Browser zugeschnitten und
    // verkleinert — leer, wenn keins hochgeladen ist
    function eigenesBild(b, max) {
      return b is string
        && (b == '' || (b.size() <= max
            && b.matches('^data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+$')));
    }

    // Inhalt eines Profils. Profil- und Titelbild sind jeweils eine Vorlage
    // ("preset:lucia") oder "eigen". Das eigene Profilbild bleibt auch dann
    // gespeichert, wenn gerade eine Vorlage gewählt ist.
    function gueltigesProfil(d) {
      return d.keys().hasOnly(profilFelder())
        && d.username is string
        && d.username.matches('^[A-Za-z0-9_.-]{3,20}$')
        && d.usernameLower == d.username.lower()
        && d.bio is string && d.bio.size() <= 300
        && d.favChar is string && d.favChar.matches('^([a-z]{2,12})?$')
        && d.lang in ['de', 'en']
        && d.updatedAt == request.time
        && d.avatar is string && d.avatar.matches('^(preset:[a-z]{2,12}|eigen)$')
        && eigenesBild(d.avatarEigen, 150000)
        && (d.avatar != 'eigen' || d.avatarEigen != '')
        && d.cover is string && d.cover.matches('^(preset:[a-z-]{2,20}|eigen)$')
        && d.plattform in ['', 'ps5', 'xbox']
        && d.edition in ['', 'standard', 'ultimate']
        // Kennungen statt fester Liste: Neue Auswahlmöglichkeiten kosten
        // dann keine neue Veröffentlichung der Regeln
        && d.vorfreude is string && d.vorfreude.matches('^([a-z-]{2,20})?$')
        && d.lieblingsort is string && d.lieblingsort.matches('^([a-z-]{2,20})?$')
        && d.gamertag is string && d.gamertag.matches('^[A-Za-z0-9 _.-]{0,24}$');
    }

    // ── Profile ─────────────────────────────────────────────────
    match /users/{uid} {
      allow get: if istSelbst(uid);
      allow list: if false;

      // Neues Profil: der Name muss im selben Schreibvorgang für diese
      // Person reserviert werden
      allow create: if istSelbst(uid)
        && gueltigesProfil(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;

      // Änderung: Erstellungsdatum bleibt, und wer den Namen wechselt,
      // muss den alten im selben Zug freigeben
      allow update: if istSelbst(uid)
        && gueltigesProfil(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid
        && (request.resource.data.usernameLower == resource.data.usernameLower
            || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.usernameLower)));

      allow delete: if istSelbst(uid);
    }

    // ── Eigenes Titelbild ───────────────────────────────────────
    // "titel" beschreibt das Bild (Anzahl Teile, Format), "titel-0" bis
    // "titel-7" enthalten die Base64-Teile. Gelesen wird nur von der
    // Person selbst.
    match /users/{uid}/bilder/{bild} {
      allow get: if istSelbst(uid);
      allow list: if false;

      allow create, update: if istSelbst(uid) && (
        (bild == 'titel'
          && request.resource.data.keys().hasOnly(['teile', 'typ'])
          && request.resource.data.teile is int
          && request.resource.data.teile >= 1 && request.resource.data.teile <= 8
          && request.resource.data.typ in ['image/webp', 'image/jpeg'])
        ||
        (bild.matches('^titel-[0-7]$')
          && request.resource.data.keys().hasOnly(['daten'])
          && request.resource.data.daten is string
          && request.resource.data.daten.size() > 0
          && request.resource.data.daten.size() <= 700000)
      );

      allow delete: if istSelbst(uid);
    }

    // ── Bestenliste des Browser-Spiels ──────────────────────────
    // Öffentlich lesbar (die Liste steht auf der Spielseite), schreiben
    // darf jeder nur seinen eigenen Eintrag.
    match /bestenliste/{uid} {
      allow read: if true;
      allow create, update: if istSelbst(uid)
        && request.resource.data.keys().hasOnly(['name', 'punkte', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 20
        && request.resource.data.punkte is int
        && request.resource.data.punkte >= 0
        && request.resource.data.punkte <= 9999999;
      allow delete: if istSelbst(uid);
    }

    // ── Benutzernamen ───────────────────────────────────────────
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;

      // Nur der Name, den das eigene Profil nach dem Schreiben trägt.
      // Ein vergebener Name lässt sich nicht überschreiben (kein update).
      allow create: if angemeldet()
        && name.matches('^[a-z0-9_.-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower == name;

      allow update: if false;

      // Freigeben nur, wenn das eigene Profil den Namen nicht mehr trägt
      // (Umbenennen oder Konto löschen)
      allow delete: if angemeldet()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameLower != name);
    }

    // ── Newsletter ──────────────────────────────────────────────
    match /newsletter/{uid} {
      allow get: if istSelbst(uid);
      allow list: if false;

      // Nur mit bestätigter Adresse, nur die eigene — so kann niemand
      // eine fremde Adresse eintragen. consentAt belegt die Einwilligung.
      allow create, update: if istSelbst(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'lang', 'consentAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.lang in ['de', 'en']
        && request.resource.data.consentAt == request.time;

      allow delete: if istSelbst(uid);
    }
  }
}
